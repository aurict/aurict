  {
   "type": "timeseries",
   "title": "Requests / s by status",
   "id": 9,
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 6
