{
 "uid": "aurict",
 "title": "Aurict",
 "tags": [
  "aurict"
 ],
 "timezone": "browser",
 "schemaVersion": 41,
 "version": 2,
 "refresh": "1m",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "editable": true,
 "templating": {
  "list": [
   {
    "name": "service",
    "type": "custom",
    "query": "backend,web,mobile-web,decision-web,quaera-web,cloudflared,postgres,redis,migrate",
    "current": {
     "text": "All",
     "value": "$__all"
    },
    "includeAll": true,
    "allValue": ".*",
    "multi": true,
    "options": []
   }
  ]
 },
 "panels": [
  {
   "type": "row",
   "title": "Overview",
   "id": 1,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 0
   },
   "collapsed": false
  },
  {
   "type": "stat",
   "title": "Sites answering",
   "id": 2,
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 4,
    "w": 9,
    "x": 0,
    "y": 1
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "label_replace(probe_success{system=\"aurict\"}, \"site\", \"$1\", \"job\", \"integrations/blackbox/(.*)\")",
     "legendFormat": "{{site}}",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     },
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "DOWN"
        },
        "1": {
         "text": "UP"
        }
       }
      }
     ]
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "name"
   }
  },
  {
   "type": "stat",
   "title": "Tunnel connections",
   "id": 3,
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 4,
    "w": 3,
    "x": 9,
    "y": 1
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "sum(cloudflared_tunnel_ha_connections{system=\"aurict\"})",
     "legendFormat": "",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value"
   }
  },
  {
   "type": "stat",
   "title": "API requests / s",
   "id": 4,
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 4,
    "w": 3,
    "x": 12,
    "y": 1
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "sum(rate(aurict_http_requests_total{system=\"aurict\"}[5m]))",
     "legendFormat": "",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     },
     "decimals": 2
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value"
   }
  },
  {
   "type": "stat",
   "title": "API 5xx share",
   "id": 5,
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 4,
    "w": 3,
    "x": 15,
    "y": 1
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "(sum(rate(aurict_http_requests_total{system=\"aurict\",status=\"5xx\"}[10m])) or vector(0)) / clamp_min(sum(rate(aurict_http_requests_total{system=\"aurict\"}[10m])),1e-9)",
     "legendFormat": "",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.01
       },
       {
        "color": "red",
        "value": 0.02
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     },
     "decimals": 2
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value"
   }
  },
  {
