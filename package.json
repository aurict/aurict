{
  "name": "aurict",
  "version": "1.2.22",
  "private": true,
  "license": "AGPL-3.0-only",
  "workspaces": [
    "packages/core",
    "packages/cli",
    "packages/aurict",
    "packages/cli-linux-x64",
    "packages/cli-linux-arm64",
    "packages/cli-darwin-x64",
    "packages/cli-darwin-arm64",
    "packages/cli-win32-x64",
    "apps/desktop",
    "apps/web"
  ],
  "scripts": {
    "dev": "bun run packages/cli/src/index.ts",
    "build": "bun run scripts/build.ts",
    "build:all": "bun run scripts/build-all.ts",
    "bump-version": "bun run scripts/bump-version.ts",
    "bump-version:cli": "bun run scripts/bump-cli-version.ts",
    "publish:all": "bun run scripts/publish.ts",
    "publish:dry": "bun run scripts/publish.ts --dry-run",
    "eval": "bun run scripts/eval.ts",
    "eval:policy": "bun run scripts/eval-agent-policy.ts",
    "eval:agent": "AURICT_EVAL_COMMAND='./dist/aurict run-agent --workdir {workdir} --instruction {prompt_json} --yes --result /tmp/aurict-eval-{task}.json' bun run scripts/eval.ts",
    "test": "bun run scripts/test.ts all",
    "test:core": "bun run scripts/test.ts core",
    "test:cli": "bun run scripts/test.ts cli",
    "test:desktop": "bun run scripts/test.ts desktop",
    "test:integration": "bun run scripts/test.ts integration",
    "test:coverage": "bun run scripts/test.ts core --coverage --coverage-reporter=lcov --coverage-dir=reports/coverage/core && bun run scripts/test.ts cli --coverage --coverage-reporter=lcov --coverage-dir=reports/coverage/cli",
    "test:stability": "bun run scripts/test.ts core --randomize --seed=20260807 --rerun-each=2 && bun run scripts/test.ts cli --randomize --seed=20260807 --rerun-each=2 && bun run scripts/test.ts desktop --randomize --seed=20260807 --rerun-each=2",
    "typecheck": "bunx tsc --noEmit -p packages/core/tsconfig.json && bunx tsc --noEmit -p packages/cli/tsconfig.json && bunx tsc --noEmit -p apps/desktop/tsconfig.json",
    "doctor": "bun run packages/cli/src/index.ts doctor",
    "doctor:json": "bun run packages/cli/src/index.ts doctor --json",
    "doctor:report": "bun run packages/cli/src/index.ts doctor --json > reports/doctor-runtime.json",
    "check:version": "bun run scripts/check-version-consistency.ts",
    "check:worker": "bun run scripts/check-compiled-worker.ts",
    "check:quality": "bun run scripts/check-quality.ts",
    "deadcode": "bunx knip --include files,dependencies",
    "smoke": "bun run build && ./dist/aurict --version",
    "hardening:check": "bun run smoke && bun run doctor",
    "hardening:strict": "bun run typecheck && bun run hardening:check",
    "quality": "bun run check:quality && bun run typecheck && bun run check:version && bun run test"
  },
  "devDependencies": {
    "@types/bun": "1.3.12",
    "drizzle-kit": "^0.29.0",
    "electron-winstaller": "5.4.4",
    "ink-testing-library": "^4.0.0",
    "typescript": "^5.8.0"
  },
  "patchedDependencies": {
    "electron-installer-redhat@3.4.0": "patches/electron-installer-redhat@3.4.0.patch"
  },
  "trustedDependencies": [
    "electron-winstaller"
  ]
}
