NODE_ENV=production
PORT=8787
DATABASE_URL=postgres://aurict:change-me@postgres:5432/aurict
DATABASE_MAX_CONNECTIONS=10
DATABASE_IDLE_TIMEOUT_SECONDS=20
DATABASE_CONNECT_TIMEOUT_SECONDS=10
# Set this in production: rate limiting falls back to a Postgres-backed limiter
# without it, which is slower and only exercised when REDIS_URL is unset.
REDIS_URL=
REDIS_CONNECT_TIMEOUT_SECONDS=5
JWT_SECRET=replace-with-at-least-32-random-characters
CORS_ORIGINS=https://aurict.com,https://app.aurict.com
TRUST_PROXY_HEADERS=false
REQUEST_BODY_LIMIT_BYTES=1000000
REQUEST_LOGS=false
PUBLIC_OPENAPI=false
METRICS_TOKEN=
REQUIRE_DEVICE_VERIFICATION=true
FIREBASE_PROJECT_ID=aurict-backend
REMOTE_MAX_ACTIVE_SESSIONS=1
REMOTE_MAX_TTL_SECONDS=300
REMOTE_MAX_IDLE_SECONDS=90
TURN_URIS=
TURN_SHARED_SECRET=
TURN_USERNAME_TTL_SECONDS=600
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
