# The build context is the repository root. Send only what the image needs, so local
# secrets (.env files, keys) and unrelated apps can never end up in a layer.
*
!apps/backend/package.json
!apps/backend/bun.lock
!apps/backend/src/**
!apps/backend/drizzle/**
!packages/backend-contract/src/**
apps/backend/src/**/test/**
