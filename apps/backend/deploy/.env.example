NODE_ENV=production
AURICT_BACKEND_HOST_PORT=3077
PORT=8787

POSTGRES_DB=aurict
POSTGRES_USER=aurict
POSTGRES_PASSWORD=CHANGE_ME_RANDOM_HEX
DATABASE_URL=postgres://aurict:CHANGE_ME_RANDOM_HEX@postgres:5432/aurict
REDIS_URL=redis://redis:6379/0
REDIS_CONNECT_TIMEOUT_SECONDS=5

JWT_SECRET=CHANGE_ME_64_PLUS_RANDOM_CHARS
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
DEVICE_LOGIN_TTL_SECONDS=600
DEVICE_LOGIN_POLL_INTERVAL_SECONDS=5
DEVICE_LOGIN_VERIFICATION_URI=https://aurict.com/auth/device

CORS_ORIGINS=https://aurict.com,https://www.aurict.com
TRUST_PROXY_HEADERS=true
REQUEST_BODY_LIMIT_BYTES=1000000
REQUEST_LOGS=false
PUBLIC_OPENAPI=false
METRICS_TOKEN=CHANGE_ME_32_PLUS_RANDOM_CHARS

REQUIRE_DEVICE_VERIFICATION=true
FIREBASE_PROJECT_ID=aurict-backend

REMOTE_MAX_ACTIVE_SESSIONS=1
REMOTE_MAX_TTL_SECONDS=300
REMOTE_MAX_IDLE_SECONDS=90

TURN_URIS=
TURN_SHARED_SECRET=
TURN_USERNAME_TTL_SECONDS=600
