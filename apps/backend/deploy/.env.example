# Copy to .env next to docker-compose.yml; chown root:root and chmod 600.
# Generate secrets with: openssl rand -hex 32

# Image to run, pinned by digest (CI prints it after each build).
AURICT_BACKEND_IMAGE=ghcr.io/aurict/aurict-backend@sha256:CHANGE_ME

# Postgres. The owner role runs migrations; the app connects as AURICT_APP_DB_USER,
# which can read and write data but not change the schema.
POSTGRES_DB=aurict
POSTGRES_USER=aurict
POSTGRES_PASSWORD=CHANGE_ME
AURICT_APP_DB_USER=aurict_app
AURICT_APP_DB_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME

# Auth. Prefer an Ed25519 keypair (scripts/generate-jwt-keys.ts) over JWT_SECRET.
JWT_SECRET=CHANGE_ME_64_PLUS_RANDOM_CHARS
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ISSUER=aurict-backend
JWT_AUDIENCE=aurict-api
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
DEVICE_LOGIN_VERIFICATION_URI=https://aurict.com/auth/device
FIREBASE_PROJECT_ID=

# HTTP. Behind Cloudflare, TRUST_PROXY_HEADERS=true makes rate limits use CF-Connecting-IP.
# Only enable it when the origin is reachable through Cloudflare alone (Tunnel or IP allowlist).
CORS_ORIGINS=https://aurict.com
TRUST_PROXY_HEADERS=true
# Shared with the web app (AURICT_BACKEND_PROXY_SECRET there) so it can pass visitor IPs.
TRUSTED_PROXY_SECRET=CHANGE_ME
REQUEST_BODY_LIMIT_BYTES=1000000
REQUEST_LOGS=true
PUBLIC_OPENAPI=false
METRICS_TOKEN=CHANGE_ME
ACTIVE_USERS_ADMIN_TOKEN=

# Email (verification and password reset) through Resend.
RESEND_API_KEY=
EMAIL_FROM=Aurict <no-reply@aurict.com>
EMAIL_LINK_BASE_URL=https://aurict.com
FEEDBACK_RETENTION_DAYS=90

# Remote control.
REQUIRE_DEVICE_VERIFICATION=true
REMOTE_MAX_ACTIVE_SESSIONS=1
REMOTE_MAX_TTL_SECONDS=300
REMOTE_MAX_IDLE_SECONDS=90
TURN_URIS=
TURN_SHARED_SECRET=
TURN_USERNAME_TTL_SECONDS=600
